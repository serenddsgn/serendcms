---
import type { GetStaticPaths } from 'astro';
import {
  ContentPageContent,
  HomeContent,
  ProjectsPageContent,
  homePath,
  type Locale,
} from '@serend/schema';
import Base from '../layouts/Base.astro';
import DemoSection from '../components/DemoSection.astro';
import { PageBlocks, planProject } from '../components/Blocks';
import { Chapter, ImageFigure, Quote } from '../components/Sections';
import { ChapterNav } from '../components/Project';
import {
  GalleryBlockView,
  ImageStrip,
  NextProject,
  ProjectAside,
  ProjectDock,
  ProjectFollowUp,
  ProjectHero,
} from '../components/Project';
import { categoryName, loadData, pageFor, projectsFor, resolveTarget, setting, studioPortraitId } from '../lib/data';
import { allEntries, findEntry, mdPath, ogPath, routeParam, type Entry } from '../lib/pages';
import { breadcrumbJsonLd, creativeWorkJsonLd, organizationJsonLd, plainText, serviceJsonLd } from '../lib/seo';
import { data } from '../lib/data';
import { t } from '../i18n';

export const getStaticPaths = (async () => {
  await loadData();
  // Deutsch liegt ohne Präfix im Wurzelverzeichnis (Startseite = leerer Pfad), Englisch unter `/en/…`
  return allEntries().map((entry) => ({ params: { path: routeParam(entry) }, props: { entry } }));
}) satisfies GetStaticPaths;

await loadData();
// Statischer Build: Eintrag kommt aus getStaticPaths; Vorschau (SSR): aus der URL.
const entry = (Astro.props as { entry?: Entry }).entry ?? findEntry(Astro.params.path);
if (!entry) return new Response(null, { status: 404 });
const locale = entry.locale as Locale;
const ui = t(locale);
const seo = setting(locale, 'seo.defaults');
const homeUrl = homePath(locale);
const siteCta = setting(locale, 'site.cta');
const cta = { label: siteCta.label, href: resolveTarget(siteCta.target) };
const portraitId = studioPortraitId(locale);
const projectsPage = pageFor(locale, 'projects');
const projectsUrl = allEntries().find((e) => e.kind === 'projects' && e.locale === locale)!.url;

let title = '';
let description: string | undefined;
let jsonLd: object[] = [];
let ogImage: string | undefined = ogPath(entry);
let ogType: 'website' | 'article' = 'website';

if (entry.kind === 'project') {
  const r = entry.project.revision;
  // Titel mit Leistung und Studio („Shop mit Konfigurator · serend.design“), damit die Fallstudie für die Leistung gefunden
  // wird und nicht mit dem Namen des Kunden konkurriert; die Marke hängt Base.astro an.
  title = r.seoTitle ?? `${r.title} – ${r.categories.map((c) => categoryName(locale, c)).join(', ')}`;
  description =
    r.seoDescription ??
    `${r.title}${r.subtitle ? `: ${plainText(r.subtitle)}` : ''} ${ui.seoBy} ${seo.siteName}.`.slice(0, 200);
  ogType = 'article';
  jsonLd = [
    creativeWorkJsonLd(entry.project, entry.url, ogImage, data()),
    serviceJsonLd(entry.project, entry.url),
    breadcrumbJsonLd([
      { name: ui.breadcrumbHome, path: homeUrl },
      { name: projectsPage.revision.title, path: projectsUrl },
      { name: r.title, path: entry.url },
    ]),
  ];
} else if (entry.kind === 'home') {
  title = entry.page.revision.seoTitle ?? seo.siteName;
  description = entry.page.revision.seoDescription ?? undefined;
  jsonLd = [organizationJsonLd(locale)];
} else {
  title = entry.page.revision.seoTitle ?? entry.page.revision.title;
  description = entry.page.revision.seoDescription ?? undefined;
  jsonLd = [
    breadcrumbJsonLd([
      { name: ui.breadcrumbHome, path: homeUrl },
      ...(entry.kind === 'projects' ? [] : [{ name: entry.page.revision.title, path: entry.url }]),
      ...(entry.kind === 'projects' ? [{ name: entry.page.revision.title, path: entry.url }] : []),
    ]),
  ];
}
const plan = planProject(entry.kind === 'project' ? (entry.project.revision.content as never) : []);
const blocks =
  entry.kind === 'home'
    ? HomeContent.parse(entry.page.revision.content)
    : entry.kind === 'projects'
    ? ProjectsPageContent.parse(entry.page.revision.content)
    : entry.kind === 'content'
      ? ContentPageContent.parse(entry.page.revision.content)
      : [];
---
<Base noindex={entry.kind === 'project' && !entry.project.revision.indexable} followLinks locale={locale} title={title} description={description} path={entry.url} alternates={entry.alternates} ogImage={ogImage} ogType={ogType} jsonLd={jsonLd} mdPath={mdPath(entry)}>
  {entry.kind === 'project' ? (
    <>
      <ProjectHero p={entry.project} locale={locale} />
      <ImageStrip p={entry.project} locale={locale} />
      {plan.segments.map((seg) =>
        seg.type === 'chapters' ? (
          <section class={`section side split${seg.first ? ' with-aside' : ''}`} style={`padding-top:${seg.first ? 128 : 0}px`}>
            {seg.first && plan.entries.length > 0 ? <ChapterNav entries={plan.entries} label={ui.chapters} /> : <div class="hide-m" />}
            <div style="max-width:760px">{seg.items.map((i) => i.b.type === 'chapter' ? <Chapter b={i.b as never} no={i.no} /> : <ImageFigure b={i.b as never} locale={locale} />)}</div>
            {seg.first && <ProjectAside p={entry.project} locale={locale} cta={cta} />}
          </section>
        ) : seg.type === 'quote' ? (
          <Quote b={seg.b as never} />
        ) : seg.type === 'image-full' ? (
          <section class="section" style="padding-bottom:96px">
            <ImageFigure b={seg.b as never} locale={locale} />
          </section>
        ) : seg.type === 'gallery' ? (
          <GalleryBlockView b={seg.b as never} locale={locale} color={entry.project.revision.tileColor ?? entry.project.revision.color} />
        ) : (
          <DemoSection locale={locale} block={seg.b as never} />
        ),
      )}
      <ProjectFollowUp locale={locale} cta={cta} portraitId={portraitId} />
      <NextProject p={entry.project} locale={locale} />
      <ProjectDock p={entry.project} locale={locale} />
    </>
  ) : (
    <PageBlocks blocks={blocks as never} locale={locale} projectCount={projectsFor(locale).length} />
  )}
</Base>
