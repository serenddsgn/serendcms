---
import '../styles/global.css';
import { homePath, type Locale } from '@serend/schema';
import { loadData, navFor, optionalSetting, resolveTarget, setting, studioPortraitId } from '../lib/data';
import { abs } from '../lib/seo';
import { t } from '../i18n';
import { Header } from '../components/Header';
import { Footer } from '../components/Footer';
import { InquiryModal } from '../components/InquiryModal';

interface Props {
  locale: Locale;
  title: string;
  description?: string | undefined;
  path: string;
  alternates?: Partial<Record<Locale, string>>;
  ogImage?: string | undefined;
  ogType?: 'website' | 'article';
  jsonLd?: object[];
  noindex?: boolean;
  mdPath?: string | undefined;
}
await loadData();
const { locale, title, description, path, alternates = {}, ogImage, ogType = 'website', jsonLd = [], mdPath } = Astro.props;
// Die Vorschau ist nie indexierbar (zusätzlich zum X-Robots-Tag der Middleware).
const preview = Astro.locals.preview === true;
const noindex = Astro.props.noindex === true || preview;
const ui = t(locale);
const identity = setting(locale, 'site.identity');
const seo = setting(locale, 'seo.defaults');
const footer = setting(locale, 'site.footer');
const cta = setting(locale, 'site.cta');
const locationTarget = optionalSetting(locale, 'site.location')?.target;
const fullTitle = title === seo.siteName ? title : `${title} · ${seo.siteName}`;
const desc = description ?? seo.description;
const link = (n: { label: string; target: { kind: 'page'; pageId: string; fragment: string | null } | { kind: 'url'; url: string } }) => ({
  label: n.label,
  href: resolveTarget(n.target),
});
const nav = navFor(locale, 'header').map(link);
const footerNav = navFor(locale, 'footer').map(link);
const legal = navFor(locale, 'legal').map(link);
const switchTo = { de: alternates.de ?? homePath('de'), en: alternates.en ?? homePath('en') };
const altEntries = Object.entries(alternates) as [Locale, string][];
const canonical = abs(path);
---
<!doctype html>
<html lang={locale} class="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          if (t === 'light') d.classList.add('light');
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      /* Seitenübergang „Welle“: Projektkachel wird zum ersten Bild der Projektseite (View Transition über Dokumente).
         Muss im Head stehen, weil pageswap/pagereveal vor dem ersten Rendern feuern. Ohne Unterstützung
         oder bei reduzierter Bewegung läuft der Vorhang wie bisher. */
      (function () {
        if (!('onpageswap' in window)) return;
        var KEY = 'serend:vt';
        var NAME = 'project-cover';
        var root = document.documentElement;
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        function media(el) {
          return el && el.querySelector('picture, video, img');
        }
        // Kachel (Startseite, Übersicht) oder Hero-Karte zu einer Projekt-URL. `kind` bevorzugt die Art, aus der man kam.
        function tileFor(url, kind) {
          var path = new URL(url, location.href).pathname;
          var links = document.querySelectorAll('.tile[href], .g[href], .hp[href], .names a[href]');
          var first = null;
          for (var i = 0; i < links.length; i++) {
            if (new URL(links[i].href).pathname !== path) continue;
            if (!kind || kindOf(links[i]) === kind) return media(links[i]);
            first = first || media(links[i]);
          }
          return first;
        }
        function kindOf(el) {
          return el.closest('.names') ? 'nm' : el.classList.contains('hp') ? 'hp' : el.classList.contains('g') ? 'g' : 'tile';
        }
        function mark(el) {
          if (el) el.style.viewTransitionName = NAME;
          return !!el;
        }
        addEventListener('pageswap', function (e) {
          var vt = e.viewTransition;
          if (!vt) return;
          var ok = false;
          if (!reduce && e.activation) {
            // Vorwärts: die angeklickte Kachel (site.ts merkt sie sich). Zurück per Browser-Button: erstes Bild der Projektseite.
            var src = window.__vtSource;
            if (src && src.isConnected && mark(media(src))) {
              ok = true;
              try {
                sessionStorage.setItem(KEY + ':kind', JSON.stringify({ p: new URL(e.activation.entry.url, location.href).pathname, k: kindOf(src) }));
              } catch (x) {}
            } else if (e.activation.navigationType === 'traverse') {
              ok = mark(document.querySelector('.strip figure'));
            }
          }
          if (ok) {
            try {
              sessionStorage.setItem(KEY, String(Date.now()));
            } catch (x) {}
          } else vt.skipTransition();
        });
        addEventListener('pagereveal', function (e) {
          var vt = e.viewTransition;
          if (!vt) return;
          var at = 0;
          var kind = null;
          var from = navigation.activation && navigation.activation.from;
          try {
            at = +sessionStorage.getItem(KEY) || 0;
            sessionStorage.removeItem(KEY);
            var r = JSON.parse(sessionStorage.getItem(KEY + ':kind') || 'null');
            if (r && from && r.p === new URL(from.url).pathname) kind = r.k;
          } catch (x) {}
          var back = null;
          var ok = !reduce && at > 0 && Date.now() - at < 8000 && (mark(document.querySelector('.strip figure')) || (from && mark((back = tileFor(from.url, kind)))));
          if (ok) {
            root.classList.add('vt-in');
            // Zurück zur Namenszeile: die Vorschau steht dort nur beim Hover, für den Morph zeigt sie sich bis zum Ende
            var link = back && back.closest ? back.closest('.names a') : null;
            if (link) {
              link.classList.add('on');
              var off = function () {
                link.classList.remove('on');
              };
              vt.finished.then(off, off);
            }
          } else vt.skipTransition();
        });
        addEventListener('pageshow', function (e) {
          if (!e.persisted) return;
          window.__vtSource = null;
          try {
            sessionStorage.removeItem(KEY);
          } catch (x) {}
          var named = document.querySelectorAll('[style*="view-transition-name"]');
          for (var i = 0; i < named.length; i++) named[i].style.viewTransitionName = '';
        });
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {altEntries.map(([l, p]) => <link rel="alternate" hreflang={l} href={abs(p)} />)}
    {altEntries.length > 0 && <link rel="alternate" hreflang="x-default" href={abs(alternates.de ?? altEntries[0]![1])} />}
    {mdPath && <link rel="alternate" type="text/markdown" href={mdPath} />}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta property="og:site_name" content={seo.siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'de' ? 'de_DE' : 'en_US'} />
    {ogImage && <meta property="og:image" content={abs(ogImage)} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="preload" href="/fonts/codec-pro-extrabold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j).replace(/</g, '\\u003c')} />)}
    <noscript><style>.pgrid[hidden],.plist[hidden]{display:revert !important}.pgrid{display:grid}.plist{display:none !important}.g,.lr,.fade,.reveal,.mask>span,.w>span{opacity:1 !important;transform:none !important;animation:none !important}</style></noscript>
  </head>
  <body>
    {preview && <div class="preview-banner mono">Vorschau · nicht öffentlich</div>}
    <a class="skip" href="#main">{ui.skip}</a>
    <div class="curtain" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
    <div class="progress liquid-bg" aria-hidden="true"></div>
    <Header locale={locale} ui={ui} nav={nav} currentPath={path} home={homePath(locale)} switchTo={switchTo} cta={{ label: cta.label, href: resolveTarget(cta.target) }} locationHref={locationTarget ? resolveTarget(locationTarget) : undefined} portraitId={studioPortraitId(locale)} />
    <InquiryModal ui={ui} locale={locale} email={identity.email} privacyHref={legal.at(-1)?.href} />
    <main id="main" key={locale}>
      <slot />
    </main>
    <Footer ui={ui} name={identity.name} city={identity.city} email={identity.email} nav={footerNav} legal={legal} legalLabel={ui.legal} copyright={footer.copyright} madeWith={footer.madeWith} />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
