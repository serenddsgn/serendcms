# Backup-Ziel, z. B. Hetzner Storage Box (SSH-Port 23). Nur öffentlicher Schlüssel (age) auf dem Server:
# Der Server kann Backups verschlüsseln, aber nicht entschlüsseln.
BACKUP_REMOTE=uXXXXXX@uXXXXXX.your-storagebox.de:serendportfolio
BACKUP_SSH_KEY=/var/lib/serendportfolio/home/.ssh/backup_ed25519
BACKUP_SSH_PORT=23
BACKUP_AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BACKUP_KEEP_LOCAL=7
