# serendCMS · Produktions-Umgebung. Wird von server-setup.sh nach /etc/serendportfolio/serendportfolio.env kopiert
# (Rechte 600, root) und dort mit zufälligen Secrets gefüllt. Nie ins Repo committen, nie in Frontend-Variablen kopieren.
NODE_ENV=production
LOG_LEVEL=info

# PostgreSQL läuft nur lokal; Anmeldung per Unix-Socket (Peer-Authentifizierung), daher gibt es kein Datenbank-Passwort.
DATABASE_URL=postgres:///serendportfolio?host=/var/run/postgresql

# API: nur localhost, Caddy ist der einzige Zugang von außen
API_HOST=127.0.0.1
API_PORT=4000
TRUST_PROXY=true
COOKIE_SECURE=true
DOCS_ENABLED=false
ADMIN_ORIGIN=https://admin.example.com
SESSION_TTL_HOURS=168

# Zufällige Secrets (mind. 32 Byte); setup erzeugt sie mit `openssl rand -base64 48`
SESSION_SECRET=__GENERATE__
BUILD_TOKEN=__GENERATE__
PREVIEW_SIGNING_KEY=__GENERATE__

# Website, Vorschau, Kontakt
SITE_URL=https://example.com
PREVIEW_URL=https://preview.example.com
CONTACT_NOTIFY_TO=
CONTACT_RETENTION_DAYS=180

# SMTP (Benachrichtigung bei neuen Kontaktanfragen)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=serend <noreply@example.com>

# Medien und Releases
STORAGE_DIR=/var/lib/serendportfolio/media
MEDIA_MAX_BYTES=15728640
RELEASES_DIR=/var/lib/serendportfolio/releases
MAINTENANCE_DIR=/var/lib/serendportfolio/maintenance
ASSET_CACHE_DIR=/var/lib/serendportfolio/cache
KEEP_RELEASES=10
BUILD_CHECK_LIGHTHOUSE=true
LIGHTHOUSE_MIN_SCORE=95
# Caddy neu laden (Redirects, CSP-Hashes). Ohne sudo: die Dienste laufen mit NoNewPrivileges. Der Befehl nutzt die lokale Admin-API
# von Caddy und braucht DOMAIN und ACME_EMAIL, um das Caddyfile zu lesen (keine Secrets).
CADDY_RELOAD_COMMAND=/usr/bin/caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# Der Worker ruft die API für den Astro-Build intern auf
API_URL=http://127.0.0.1:4000

# Browser für Lighthouse (liegt im Datenverzeichnis, nicht im Home des Dienstbenutzers)
PLAYWRIGHT_BROWSERS_PATH=/var/lib/serendportfolio/browsers
HOME=/var/lib/serendportfolio/home
