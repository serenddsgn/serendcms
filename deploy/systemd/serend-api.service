[Unit]
Description=serendCMS API (Fastify)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=serend
Group=serend
WorkingDirectory=/srv/serendportfolio
EnvironmentFile=/etc/serendportfolio/serendportfolio.env
ExecStart=/usr/bin/env pnpm --filter @serend/api start
Restart=on-failure
RestartSec=3
# Härtung
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
ReadWritePaths=/var/lib/serendportfolio /srv/serendportfolio

[Install]
WantedBy=multi-user.target
