[Unit]
Description=serendCMS Vorschau (Astro SSR)
After=network.target serend-api.service

[Service]
Type=simple
User=serend
Group=serend
WorkingDirectory=/srv/serendportfolio
# Eigene Env-Datei ohne Secrets: der Vorschau-Prozess kennt weder Datenbank noch Build-Token
EnvironmentFile=/etc/serendportfolio/preview.env
ExecStart=/usr/bin/env node apps/web/dist-preview/server/entry.mjs
Restart=on-failure
RestartSec=3
# Härtung
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
ReadWritePaths=/var/lib/serendportfolio /srv/serendportfolio

[Install]
WantedBy=multi-user.target
