# serendCMS · Beispiel-Konfiguration. Kopie nach `.env` (oder `pnpm setup:env`, erzeugt Secrets).
# `.env` ist in .gitignore und wird nie committet.
# Secrets existieren NUR in api und worker. Niemals als VITE_* oder PUBLIC_* ins Frontend.

NODE_ENV=development             # development | test | production
LOG_LEVEL=info                   # fatal|error|warn|info|debug|trace|silent

# ── API ────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1               # in Produktion nur localhost
API_PORT=4000
DATABASE_URL=postgres://serend:serend@127.0.0.1:5432/serend
ADMIN_ORIGIN=http://localhost:5173   # erlaubter Origin für schreibende Requests (Same-Origin, kein CORS)
COOKIE_SECURE=false              # in Produktion true (Pflicht). Safari akzeptiert Secure-Cookies auf http://localhost nicht.
TRUST_PROXY=false                # true, wenn die API hinter Caddy läuft
DOCS_ENABLED=true                # OpenAPI unter /internal/docs (nur lokal/intern); in Produktion false
SESSION_TTL_HOURS=168            # absolute Lebensdauer einer Session

# ── Secrets (mind. 32 Byte Zufall, z. B. `openssl rand -base64 48`) ─────
SESSION_SECRET=                  # HMAC-Schlüssel für Session-Token
BUILD_TOKEN=                     # Zugriff auf /internal/build/*
PREVIEW_SIGNING_KEY=             # Signatur der Vorschau-Links
SECRETS_ENCRYPTION_KEY=          # Optional. Verschlüsselt im Admin hinterlegte API-Keys in der Datenbank (ohne: Eingabe im Admin gesperrt)

# ── Automatische Übersetzung (Claude) ──────────────────────────────────
ANTHROPIC_API_KEY=               # Optional. Hat Vorrang vor dem im Admin (Einstellungen) hinterlegten Key

# ── SMTP (lokal: Mailpit) ──────────────────────────────────────────────
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=serend <noreply@localhost>

# ── Seed (nur lokal; Produktion legt den ersten Admin per CLI an) ───────
SEED_ADMIN_EMAIL=admin@serend.local
SEED_ADMIN_PASSWORD=             # leer = zufällig, wird einmalig im Terminal ausgegeben

# ── Medien ─────────────────────────────────────────────────────────────
STORAGE_DIR=.data/media          # lokales Storage-Verzeichnis (Produktion: /var/lib/serendportfolio/media)
MEDIA_MAX_BYTES=15728640         # Upload-Limit pro Bild (15 MiB)
MEDIA_VIDEO_MAX_BYTES=62914560   # Upload-Limit pro Video (60 MiB)

# ── Builds und Releases (api + worker) ─────────────────────────────────
RELEASES_DIR=.data/releases      # releases/<id>/ und der Symlink `current` (Caddy liefert `current` aus)
SITE_URL=http://localhost:4321   # öffentliche Basis-URL für Canonical, Sitemap, OG (worker)
API_URL=http://127.0.0.1:4000    # interne API-Adresse für den Astro-Build (worker)
KEEP_RELEASES=10                 # so viele Releases bleiben für den Rollback erhalten
BUILD_CHECK_LIGHTHOUSE=false     # lokal aus; in Produktion true (Performance ≥ 95)
LIGHTHOUSE_MIN_SCORE=95
# CADDY_RELOAD_COMMAND=/usr/bin/caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile   # lädt Redirects nach Releasewechsel (optional)

# ── Website, Vorschau, Kontakt ─────────────────────────────────────────
PREVIEW_URL=http://localhost:4323  # Basis-URL der Vorschau (Subdomain preview.<domain>)
CONTACT_NOTIFY_TO=                 # Empfänger für neue Kontaktanfragen (leer = keine E-Mail)
CONTACT_RETENTION_DAYS=180         # Kontaktnachrichten werden danach gelöscht
DEPLOY_DIR=.data/deploy            # Anfrage-/Status-Dateien des Code-Deployments aus dem Admin (Produktion: /var/lib/serendportfolio/deploy)
MAINTENANCE_DIR=.data/maintenance  # Wartungsseite und Flag-Datei `on` (Caddy prüft die Datei, ohne das Backend zu fragen)
