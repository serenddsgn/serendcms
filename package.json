{
  "name": "serendportfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @serend/api --filter @serend/admin --filter @serend/web dev",
    "setup:env": "node scripts/setup-env.mjs",
    "db:generate": "pnpm --filter @serend/db generate",
    "db:migrate": "pnpm --filter @serend/db migrate",
    "db:seed": "pnpm --filter @serend/api seed",
    "test": "pnpm -r --workspace-concurrency=1 test && vitest run --root scripts && pnpm audit --audit-level=high",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "check:secrets": "pnpm --filter @serend/admin build && pnpm --filter @serend/web build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
